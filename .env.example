# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.
# Leave Supabase values empty to run in DEMO MODE with sample data.

# Public URL of the portal (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://portal.example.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Jobber (developer.getjobber.com → your app)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# GraphQL API version header Jobber requires, e.g. 2025-01-20 (check Jobber's docs for the current one)
JOBBER_API_VERSION=2025-01-20

# Resend (resend.com → API Keys). Sender must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Polaris <visits@example.com>"

# Secret used to protect the manual sync endpoint (any long random string)
ADMIN_SECRET=
